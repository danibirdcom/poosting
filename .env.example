# --- Base ---
DATABASE_URL=postgresql://redactia:redactia@localhost:5432/redactia
REDIS_URL=redis://localhost:6379/0

# --- Storage (MinIO en dev) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=redactia-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=eu-central-1

# --- LLMs ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Search ---
BRAVE_SEARCH_API_KEY=

# --- Trends ---
X_API_BEARER_TOKEN=

# --- Bancos de imagen ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# --- GSC ---
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=

# --- Auth dashboard ---
AUTH_SECRET=changeme-in-prod
NEXTAUTH_URL=http://localhost:3000

# --- Cifrado pgcrypto ---
# Clave maestra usada para cifrar cms_config y otras columnas sensibles.
# Generar en prod con: openssl rand -base64 32
PGCRYPTO_MASTER_KEY=dev-only-key-do-not-use-in-prod

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
