# DSN del usuario login con membership en el rol redactia_web.
# NO uses redactia_app (workers) ni redactia_admin (migraciones).
# Patrón rol grupo + usuario login: ver db/migrations/007 y CLAUDE.md §16.
#
# SSL es automático: lib/db.ts fuerza SSL con rejectUnauthorized:false para
# cualquier host que NO sea localhost / 127.0.0.1 / ::1. No añadas
# ?sslmode=require ni ?uselibpqcompat=true al DSN — pg ≥8.13 las trata
# como verify-full y romperían la conexión a RDS.
#
# Ejemplo dev (Postgres local sin SSL):
DATABASE_URL_WEB=postgres://redactia_web_dev:CAMBIAR@localhost:5432/redactia_dev
#
# Ejemplo staging (RDS — SSL se añade automáticamente, no toques el DSN):
# DATABASE_URL_WEB=postgres://redactia_web_dev:CAMBIAR@redactia.xxx.eu-west-3.rds.amazonaws.com:5432/redactia_staging

# Hardcoded en PR1 (sin auth todavía). En PR2 viene de la sesión NextAuth.
# Valor: UUID del medio para el que el usuario es editor.
MEDIO_ID_HARDCODED=00000000-0000-0000-0000-000000000000

NEXT_PUBLIC_APP_NAME=Redactia
